{
  "name": "triagesync-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test src/*/*.test.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:indexes": "node src/db/migrate.js --indexes",
    "db:drop-indexes": "node src/db/migrate.js --drop-indexes",
    "db:setup": "node src/db/migrate.js && node src/db/migrate.js --indexes",
    "seed": "node src/db/seed.js",
    "test:concurrency": "node scripts/concurrency-test.js",
    "bench": "node scripts/benchmark.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
