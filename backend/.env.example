# Server
PORT=4000
# Allowed browser origin for CORS (your deployed frontend URL). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173

# Database (hosted Postgres, e.g. Neon). Example value is a dummy.
DATABASE_URL=postgresql://user:password@host.example.com:5432/triagesync?sslmode=require
# Set to "false" for a local Postgres without TLS
DB_SSL=true

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_COST=10

# Scripts only (concurrency test / benchmark)
API_URL=http://localhost:4000
